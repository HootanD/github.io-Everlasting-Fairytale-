name: Docker Image Security Scan

on:
  workflow_run:
    workflows: ['CI/CD Pipeline']
    types: [completed]
  schedule:
    - cron: '0 2 * * *'  # Daily at 2 AM UTC
  workflow_dispatch:

permissions:
  contents: read
  security-events: write

jobs:
  scan-latest-image:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Scan image with Trivy (vulnerabilities)\n        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ghcr.io/${{ github.repository }}:latest
          format: 'sarif'
          output: 'trivy-vuln.sarif'
          severity: 'CRITICAL,HIGH'
      
      - name: Upload Trivy vulnerability results
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: 'trivy-vuln.sarif'
          category: 'trivy-vulnerabilities'
      
      - name: Scan image with Trivy (misconfigurations)
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ghcr.io/${{ github.repository }}:latest
          scan-type: 'config'
          format: 'sarif'
          output: 'trivy-config.sarif'
          severity: 'CRITICAL,HIGH'
      
      - name: Upload Trivy config results
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: 'trivy-config.sarif'
          category: 'trivy-config'
      
      - name: Scan image with Snyk (optional - requires token)
        if: secrets.SNYK_TOKEN != ''
        run: |
          npm install -g snyk
          snyk auth ${{ secrets.SNYK_TOKEN }}
          snyk container test ghcr.io/${{ github.repository }}:latest --severity-threshold=high
        continue-on-error: true
